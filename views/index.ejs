<!DOCTYPE html>
<html>

<head>

    <title>User Management System</title>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <!-- BOOTSTRAP CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>
<div class="text-center mb-4">

    <button
        id="themeBtn"
        class="btn btn-dark"
    >
        Dark Mode
    </button>

</div>

<body
    class="bg-light"
    id="body"
>

    <div class="container mt-5">


        <!-- HEADING -->
        <h1 class="text-center text-primary mb-5">
            User Management System
        </h1>


        <!-- ADD USER FORM -->
        <div class="card shadow p-4 mb-5">

            <form
                action="/add-user"
                method="POST"
                enctype="multipart/form-data"
            >

                <div class="mb-3">

                    <input
                        type="text"
                        name="name"
                        class="form-control"
                        placeholder="Enter Name"
                        required
                    >

                </div>


                <div class="mb-3">

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter Email"
                        required
                    >

                    <div class="mb-3">

                        <input
                            type="file"
                            name="profile"
                            class="form-control"
                        >

                    </div>

                </div>

                <div class="text-center mt-5">

                    <% if(currentPage > 1){ %>

                    <a
                        href="/?page=<%= currentPage - 1 %>"
                        class="btn btn-dark"
                    >
                        Previous
                    </a>

                    <% } %>



                    <a
                        href="/?page=<%= currentPage + 1 %>"
                        class="btn btn-primary"
                    >
                        Next
                    </a>

                </div>


                <button
                    type="submit"
                    class="btn btn-primary w-100"
                >
                    Add User
                </button>

            </form>

            <hr class="my-5">

                <div class="card shadow p-4">

                    <h2 class="mb-4">
                        Upload Profile Image
                    </h2>

             <form
                action="/upload"
                method="POST"
                enctype="multipart/form-data"
            >

            <input
                type="file"
                name="profiles"
                class="form-control mb-3"
                multiple
            >

            <button class="btn btn-success">

                    Upload Image

            </button>

            </form>

</div>

        </div>


        <div class="mb-4">

            <input
                type="text"
                id="searchInput"
                class="form-control"
                placeholder="Search User..."
            >

        </div>
        
        <!-- USER LIST -->
        <div class="row">

            <% users.forEach((user) => { %>

                <div class="col-md-4 user-card">

                    <div class="card shadow p-3 mb-4">

                        <img
                            src="<%= user.profileImage %>"
                            class="img-fluid rounded mb-3"
                            height="200"
                        >

                        <h3 class="text-primary user-name">
                            <%= user.name %>
                        </h3>

                        <p>
                            <%= user.email %>
                        </p>


                        <!-- EDIT BUTTON -->
                        <a
                            href="/edit-user/<%= user._id %>"
                            class="btn btn-warning w-100 mb-2"
                        >
                            Edit
                        </a>


                        <!-- DELETE BUTTON -->
                        <a
                            href="/delete-user/<%= user._id %>"
                            class="btn btn-danger w-100"
                        >
                            Delete
                        </a>

                        <a
                            href="/user/<%= user._id %>"
                            class="btn btn-info w-100 mt-2"
                        >
                            View Profile
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

<script>

    const searchInput = document.getElementById(

        "searchInput"

    );



    searchInput.addEventListener(

        "keyup",

        () => {

            const value = searchInput.value.toLowerCase();


            const cards = document.querySelectorAll(

                ".user-card"

            );


            cards.forEach((card) => {

                const name = card

                    .querySelector(".user-name")

                    .innerText

                    .toLowerCase();


                if(name.includes(value)){

                    card.style.display = "block";

                }

                else{

                    card.style.display = "none";

                }

            });

        }

    );

</script>

<script>

    const themeBtn = document.getElementById(

        "themeBtn"

    );



    const body = document.getElementById(

        "body"

    );



    let darkMode = false;



    themeBtn.addEventListener(

        "click",

        () => {

            darkMode = !darkMode;


            if(darkMode){

                body.classList.remove(

                    "bg-light"

                );

                body.classList.add(

                    "bg-dark"

                );

                body.style.color = "white";


                themeBtn.innerText = "Light Mode";

            }

            else{

                body.classList.remove(

                    "bg-dark"

                );

                body.classList.add(

                    "bg-light"

                );

                body.style.color = "black";


                themeBtn.innerText = "Dark Mode";

            }

        }

    );

</script>

</body>

</html>